# Production .env — copy to .env on the VPS and fill in real values.
# Differences from the dev .env.example that matter for production:

# ---------- App ----------
NODE_ENV=production
PORT=4000
APP_URL=https://your-domain-here.example.com
# Your actual website's domain(s) that will call the API from a browser.
# Never use "*" in production — that would let any website call your API
# with a logged-in staff member's browser session.
CORS_ORIGIN=https://your-domain-here.example.com

# ---------- PostgreSQL ----------
# Generate a real random password, not the dev default:
#   openssl rand -base64 24
DATABASE_URL=postgres://r2l_user:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/r2l_chatbot
PGHOST=postgres
PGPORT=5432
PGUSER=r2l_user
PGPASSWORD=REPLACE_WITH_STRONG_PASSWORD
PGDATABASE=r2l_chatbot

# ---------- Auth ----------
# Generate real random secrets — do NOT reuse the dev placeholders:
#   openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Qdrant ----------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=r2l_knowledge_base

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-REPLACE_WITH_REAL_PRODUCTION_KEY
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- WhatsApp (Meta Cloud API) ----------
# Use a PERMANENT token (via a System User in Meta Business Settings), not
# the 24-hour temporary token used for local testing — that will expire and
# silently break replies in production.
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_A_TOKEN_YOU_CHOOSE
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_PERMANENT_SYSTEM_USER_TOKEN
WHATSAPP_PHONE_NUMBER_ID=

# ---------- Facebook Messenger ----------
MESSENGER_VERIFY_TOKEN=REPLACE_WITH_A_TOKEN_YOU_CHOOSE
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- File uploads ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
