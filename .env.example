# ---------- App ----------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ---------- PostgreSQL ----------
DATABASE_URL=postgres://r2l_user:r2l_password@localhost:5432/r2l_chatbot
PGHOST=localhost
PGPORT=5432
PGUSER=r2l_user
PGPASSWORD=r2l_password
PGDATABASE=r2l_chatbot

# ---------- Auth ----------
JWT_SECRET=change_me_dev_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_me_dev_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=r2l_knowledge_base

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-xxxxx
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- WhatsApp (Meta Cloud API) ----------
WHATSAPP_VERIFY_TOKEN=change_me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- Facebook Messenger ----------
MESSENGER_VERIFY_TOKEN=change_me
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=

# ---------- File uploads ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
